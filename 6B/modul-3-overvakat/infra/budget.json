{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "notificationEmail": { "type": "securestring" },
    "startDate": { "type": "string" },
    "amount": { "type": "int", "defaultValue": 50 }
  },
  "resources": [{
    "type": "Microsoft.Consumption/budgets",
    "apiVersion": "2024-08-01",
    "name": "budget-novatrix-6b",
    "properties": {
      "category": "Cost",
      "amount": "[parameters('amount')]",
      "timeGrain": "Monthly",
      "timePeriod": { "startDate": "[parameters('startDate')]" },
      "notifications": {
        "Half": { "enabled": true, "operator": "GreaterThanOrEqualTo", "threshold": 50, "thresholdType": "Actual", "contactEmails": ["[parameters('notificationEmail')]"], "locale": "sv-se" },
        "Full": { "enabled": true, "operator": "GreaterThanOrEqualTo", "threshold": 100, "thresholdType": "Actual", "contactEmails": ["[parameters('notificationEmail')]"], "locale": "sv-se" }
      }
    }
  }]
}
