{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "swedencentral"
    },
    "vnetName": {
      "type": "string",
      "defaultValue": "vnet-novatrix"
    },
    "hostStorageName": {
      "type": "string"
    },
    "sourceStorageName": {
      "type": "string"
    },
    "functionName": {
      "type": "string"
    },
    "deployerObjectId": {
      "type": "string",
      "defaultValue": ""
    },
    "notificationEmail": {
      "type": "securestring"
    }
  },
  "resources": [
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "id-novatrix-6b",
      "properties": {},
      "location": "[parameters('location')]"
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups/securityRules",
      "apiVersion": "2023-09-01",
      "name": "nsg-novatrix-private/Allow-6B-Function-Storage-TLS",
      "properties": {
        "priority": 110,
        "direction": "Inbound",
        "access": "Allow",
        "protocol": "Tcp",
        "sourceAddressPrefix": "10.10.5.0/24",
        "sourcePortRange": "*",
        "destinationAddressPrefix": "10.10.2.0/24",
        "destinationPortRange": "443"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[parameters('hostStorageName')]",
      "properties": {
        "allowBlobPublicAccess": false,
        "allowSharedKeyAccess": false,
        "supportsHttpsTrafficOnly": true,
        "minimumTlsVersion": "TLS1_2",
        "publicNetworkAccess": "Enabled"
      },
      "location": "[parameters('location')]",
      "kind": "StorageV2",
      "sku": {
        "name": "Standard_LRS"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/queueServices/queues",
      "apiVersion": "2023-05-01",
      "name": "[concat(parameters('hostStorageName'), '/default/kundtjanst-notiser')]",
      "properties": {},
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('hostStorageName'))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/queueServices/queues",
      "apiVersion": "2023-05-01",
      "name": "[concat(parameters('hostStorageName'), '/default/azure-webjobs-blobtrigger-', take(toLower(parameters('functionName')), 32))]",
