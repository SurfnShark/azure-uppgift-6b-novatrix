        "[resourceId('Microsoft.Storage/storageAccounts', parameters('hostStorageName'))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/queueServices/queues",
      "apiVersion": "2023-05-01",
      "name": "[concat(parameters('sourceStorageName'), '/default/webjobs-blobtrigger-poison')]",
